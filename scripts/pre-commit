#!/bin/bash
# .git/hooks/pre-commit
# When a canonical ZooData shared file is staged, sync and stage all copies.

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Check whether either canonical shared file is staged in this commit.
if git diff --cached --name-only | grep -Eq "^zoodata/(scripts/zoodata.py|references/cli-result-contract.md)$"; then
  echo "Detected canonical ZooData shared-file changes, syncing copies..."
  bash "$REPO_ROOT/scripts/sync-scripts.sh"
  git add "$REPO_ROOT"/amazon-*/scripts/zoodata.py
  git add "$REPO_ROOT"/amazon-*/references/cli-result-contract.md
  echo "Shared copies synced and staged for this commit."
fi
